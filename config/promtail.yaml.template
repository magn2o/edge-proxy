server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://${LOKI_HOST}:3100/loki/api/v1/push

scrape_configs:
  - job_name: nginx
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          region: ${REGION}
          __path__: /var/log/nginx/*.log

  - job_name: docker
    static_configs:
      - targets: [localhost]
        labels:
          job: docker
          region: ${REGION}
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      - json:
          expressions:
            output: log
      - output:
          source: output
